{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "havyn-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["TMDB_API_TOKEN"]
  },
  "vars": {
    "CLIENT_ORIGIN": "http://127.0.0.1:5173",
    "NEWS_FEEDS": "https://variety.com/v/film/news/feed/,https://deadline.com/v/film/feed/"
  },
  "env": {
    "production": {
      "name": "havyn-content",
      "vars": {
        "CLIENT_ORIGIN": "*",
        "NEWS_FEEDS": "https://variety.com/v/film/news/feed/,https://deadline.com/v/film/feed/"
      }
    }
  }
}
