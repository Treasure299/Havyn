{
  "name": "@havyn/desktop",
  "version": "2.5.0-beta.5",
  "description": "Havyn desktop MVP for private watch parties.",
  "author": "Havyn",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:cloudflare": "concurrently \"vite --mode cloudflare --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "vite": "vite --host 127.0.0.1",
    "electron": "electron .",
    "test:playback": "node --test electron/playbackEventClassifier.test.js electron/protectedPlaybackAdapter.test.js",
    "test:media-source": "node --test src/lib/mediaSource.test.js src/lib/playbackDelivery.test.js src/lib/callDeviceDiscovery.test.js src/lib/captureGeometry.test.js src/lib/domBrowserBridge.test.js src/lib/webviewLifecycle.test.js",
    "test:permissions": "node --test electron/browserPermissionPolicy.test.js electron/callMediaPermission.test.js electron/displayMediaSelection.test.js electron/screenSharePermission.test.js electron/widevineRuntime.test.js",
    "test:realtime": "node --test src/lib/cloudflareRealtimeSocket.test.js src/lib/playbackMaintenance.test.js",
    "test:content": "node --test src/lib/contentCatalog.test.js",
    "test:webview-routing": "electron electron/webviewMediaRouting.integration.cjs",
    "test:widevine": "electron electron/widevineSmoke.cjs",
    "build": "vite build",
    "build:cloudflare": "vite build --mode cloudflare",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:cloudflare": "npm run build:cloudflare && electron-builder --win nsis --config.directories.output=release-cloudflare",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64",
    "dist:widevine:win": "npm run build:cloudflare && node electron/buildWidevine.cjs"
  },
  "build": {
    "appId": "app.havyn.desktop",
    "productName": "Havyn",
    "electronVersion": "42.5.2",
    "electronDist": "../../node_modules/electron/dist",
    "artifactName": "Havyn-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "afterPack": "electron/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/brand/havyn-icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/brand/havyn-icon.icns",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Havyn needs camera access when you join a room video call.",
        "NSMicrophoneUsageDescription": "Havyn needs microphone access when you join a room voice or video call.",
        "NSScreenCaptureUsageDescription": "Havyn needs screen recording access only when you start Live Share.",
        "NSAudioCaptureUsageDescription": "Havyn needs system audio capture access only when you include audio in Live Share."
      }
    },
    "dmg": {
      "artifactName": "Havyn-${version}-macOS-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Havyn",
      "installerIcon": "public/brand/havyn-icon.ico",
      "uninstallerIcon": "public/brand/havyn-icon.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "ably": "^2.21.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "github:castlabs/electron-releases#v42.5.2+wvcus",
    "electron-builder": "^26.8.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
